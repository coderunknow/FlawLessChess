+        // while every defence may be quiet (queen-trap blindness, benches/diagnostics/
+        // 2026-11-27), so a position with an attacked queen of the side to move is
+        // searched normally here. The guard costs one queen scan and at most two
+        // is_attacked probes per RFP-eligible node only.
         if depth <= 3 && !in_chk && !is_pv && !fifty_claim && beta.abs() < MATE_BOUND && !sparse {
-            let s = self.static_eval(pos);
-            if s - 150 * depth >= beta {
-                return beta;
+            let us = pos.side;
+            let opp = us ^ 1;
+            let mut queens = pos.pieces[us * 6 + QUEEN];
+            let mut hanging_queen = false;
