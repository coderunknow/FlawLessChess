+
+/// Queen-trap regression suite (ENGINE-5 fix, benches/diagnostics/ 2026-11-27).
+///
+/// Defect: a quiet-reply queen trap is invisible to capture-only quiescence —
+/// the queen's own flight moves are quiet, so the searched line never contains
+/// the queen actually being captured at a flight square, stand pat keeps the
+/// static score (queen counted as alive), and reverse futility sealing keeps
+/// even quiescence from starting. Against ENGINE-4 this cost 9 decisive losses
+/// (28 falls / 13 provable traps / 13 cases); root cause and the fix contract
+/// are documented in AGENTS_LOG.md. Every fixture here is a real game FEN from
+/// `benches/diagnostics/trap_cases.json` or a mechanically derived variant.
+#[cfg(test)]
+mod queen_trap_tests {
+    use super::*;
+    use crate::movegen::generate_legal;
+    use std::sync::atomic::AtomicBool;
+    use std::sync::{Arc, Mutex};
+
+    fn position(fen: &str) -> Position {
+        Position::from_fen(fen).expect("test FEN")
+    }
+
+    fn run_root(fen: &str, depth: i32) -> SearchResult {
+        let mut pos = position(fen);
+        let mut tt = TranspositionTable::new(4);
+        let stop = AtomicBool::new(false);
+        let limits = Arc::new(Mutex::new(SearchLimits {
+            max_depth: depth,
+            ..SearchLimits::default()
+        }));
+        let mut s = Searcher::new(&mut tt, &stop, limits);
+        s.search_root(&mut pos, None, 1, &mut |_| {})
+    }
+
+    fn run_quiesce(fen: &str) -> (i32, i32) {
+        let mut pos = position(fen);
+        let mut tt = TranspositionTable::new(4);
+        let stop = AtomicBool::new(false);
+        let limits = Arc::new(Mutex::new(SearchLimits {
+            max_depth: 1,
+            ..SearchLimits::default()
+        }));
+        let mut s = Searcher::new(&mut tt, &stop, limits);
+        let sp = s.static_eval(&mut pos);
+        let q = s.quiesce(&mut pos, -MATE_BOUND, MATE_BOUND, 0);
+        (sp, q)
+    }
+
+    /// The 8 "needle" trap cases (1-2 trap-allowing moves among 33-49 legal ones)
+    /// from `benches/diagnostics/trap_cases.json`. The played move in each row is
+    /// the trap-allowing move the game actually chose; the search must not pick
+    /// it once the blindness is fixed.
+    #[test]
+    fn needle_trap_moves_are_avoided() {
+        let cases: [(&str, &str); 8] = [
+            (
+                "3rr3/pb1Q1pk1/1p5p/2pPq1p1/1n6/2N1P2P/PP3PP1/1B1RR1K1 w - - 1 21",
+                "d7b7",
+            ), // topple-0.1.1-e4-ply40 allowing 1/42
+            (
+                "r3r1k1/pp3ppp/1qbb4/2nQP3/8/3P1N1P/PPPB2P1/1R1K1B1R w - - 1 18",
+                "d5d6",
+            ), // topple-0.1.1-e4-ply34 allowing 1/44
+            (
+                "k1r5/1p3Q2/8/2qpB3/2b2P2/1P5P/6P1/2R4K b - - 0 41",
+                "c5a3",
+            ), // topple-0.2.1-e4-ply81 allowing 2/33
+            (
+                "r4rk1/1b3ppp/2nq1n2/p7/2p5/1QB1PN2/PP3PPP/R4RK1 w - - 0 16",
+                "b3b7",
+            ), // topple-0.2.1-e4-ply30 allowing 1/38
+            (
+                "r4r2/pb2Nkp1/2p2pB1/1p2q1p1/8/5P2/PP1B1K2/2R3QR b - - 3 23",
+                "f7e7",
+            ), // topple-0.1.1-e4b-ply45 allowing 2/2
+            (
+                "6r1/1k5p/1pp4r/p2bp3/Q3p1p1/P2P3q/1P1RNP1P/6KR w - - 0 39",
+                "d3e4",
+            ), // topple-0.1.1-e4b-ply76 allowing 2/23
+            (
+                "6rk/pp2rpp1/2n2n1p/1R1p2Bq/3Pp3/P1P2PR1/P3BPKP/2Q5 b - - 3 25",
+                "h6g5",
+            ), // topple-0.2.1-e4b-ply49 allowing 2/36
+            (
+                "r3r1k1/1pbb1ppp/p2p1n2/1NpP4/P2qP3/1P1B3P/2QB1PP1/3RR1K1 b - - 10 22",
+                "a6b5",
+            ), // akimbo-0.1.1-e4b-ply43 allowing 1/49
+        ];
+        for (fen, trap_move) in cases {
+            let best = run_root(fen, 8).best_move.to_string();
+            assert_ne!(
+                best, trap_move,
+                "search picked the trap-allowing move {trap_move} in {fen}"
+            );
+        }
+    }
+
+    /// The core blindness: at a node whose queen is attacked with no safe
+    /// defence, capture-only stand pat returned `static_eval` as if the queen
+    /// were alive. Real fixture: topple-0.1.1-e4 ply 34, after Qd5-d6?!
+    /// Rad8-d8 (the queen is attacked and cannot escape loss).
+    #[test]
+    fn stand_pat_cannot_hide_a_lost_queen() {
+        let fen = "3rr1k1/pp3ppp/1qbQ4/2n1P3/8/3P1N1P/PPPB2P1/1R1K1B1R w - - 1 19";
+        let (sp, q) = run_quiesce(fen);
+        assert!(
+            q < sp - 700,
+            "quiesce must see the lost queen: static {sp} vs quiesce {q}"
+        );
+    }
+
+    /// Color-mirrored twin of `stand_pat_cannot_hide_a_lost_queen`: the fix
+    /// scans `pos.pieces[us * 6 + QUEEN]` for the mover regardless of color.
+    #[test]
+    fn stand_pat_cannot_hide_a_lost_queen_color_mirrored() {
+        let fen = "1r1k1b1r/pppb2p1/3p1n1p/8/2N1p3/1QBq4/PP3PPP/3RR1K1 b - - 1 19";
+        let (sp, q) = run_quiesce(fen);
+        assert!(
+            q < sp - 700,
+            "mirrored quiesce must see the lost queen: static {sp} vs quiesce {q}"
+        );
+    }
+
+    /// Reverse futility at depth <= 3 could return `beta` before any defence
+    /// was searched. With beta shaped so the old condition `sp - 150*depth >=
+    /// beta` fires, the guard must force the node to be searched and the queen
+    /// loss must show instead of a blind fail-high.
+    #[test]
+    fn rfp_does_not_seal_an_attacked_queen() {
+        let fen = "3rr1k1/pp3ppp/1qbQ4/2n1P3/8/3P1N1P/PPPB2P1/1R1K1B1R w - - 1 19";
+        let mut pos = position(fen);
+        let mut tt = TranspositionTable::new(4);
+        let stop = AtomicBool::new(false);
+        let limits = Arc::new(Mutex::new(SearchLimits {
+            max_depth: 3,
+            ..SearchLimits::default()
+        }));
+        let mut s = Searcher::new(&mut tt, &stop, limits);
+        let sp = s.static_eval(&mut pos);
+        let beta = sp - 500;
+        let score = s.search(&mut pos, 3, beta - 1, beta, 0, None);
+        assert!(
+            score < beta,
+            "RFP sealed an attacked-queen node: returned {score} with beta {beta} (static {sp})"
+        );
+    }
+
+    /// The guard must be narrow: with no attacked queen, RFP keeps its exact
+    /// fail-high behaviour (returns beta unchanged).
+    #[test]
+    fn rfp_still_applies_without_an_attacked_queen() {
+        let fen = "r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3";
+        let mut pos = position(fen);
+        let mut tt = TranspositionTable::new(4);
+        let stop = AtomicBool::new(false);
+        let limits = Arc::new(Mutex::new(SearchLimits {
+            max_depth: 3,
+            ..SearchLimits::default()
+        }));
+        let mut s = Searcher::new(&mut tt, &stop, limits);
+        let sp = s.static_eval(&mut pos);
+        let beta = sp - 500;
+        let score = s.search(&mut pos, 3, beta - 1, beta, 0, None);
+        assert_eq!(
+            score, beta,
+            "RFP must keep its fail-high without an attacked queen (static {sp})"
+        );
+    }
+
+    /// Multi-queen node: the scan must cover every queen of the mover and see
+    /// the hanging one even with a second queen on the board.
+    #[test]
+    fn multiple_queens_scanned() {
+        let fen = "3r2k1/8/3Q4/8/8/8/8/Q4K2 w - - 0 1";
+        let (sp, q) = run_quiesce(fen);
+        assert!(
+            q < sp - 700,
+            "quiesce must see the hanging queen among two: static {sp} vs quiesce {q}"
+        );
+    }
+
+    /// Behaviour preservation: when no queen is attacked the qsearch keeps
+    /// standing pat — a capture-free position returns exactly `static_eval`.
+    #[test]
+    fn quiet_quiescence_still_stands_pat() {
+        let fen = "4k3/4p3/8/8/8/8/4P3/4K3 w - - 0 1";
+        let (sp, q) = run_quiesce(fen);
+        assert_eq!(sp, q, "quiet quiesce must stand pat (static {sp}, got {q})");
+    }
+
+    /// In-check handling is untouched by the fix: evasions are already searched
+    /// in full there. Fixture is in check AND has an attacked queen; the search
+    /// must return a legal move without panicking.
+    #[test]
+    fn in_check_attacked_queen_stays_legal() {
+        let fen = "6k1/8/8/6rQ/q7/8/8/3K4 w - - 0 1";
+        let r = run_root(fen, 4);
+        let legal = generate_legal(&position(fen));
+        assert!(
+            legal.iter().any(|m| *m == r.best_move),
+            "best move {} must be legal in check fixture",
+            r.best_move
+        );
+    }
+
+    /// The qsearch move-list widening must not leak into `searchmoves`
+    /// filtering: a filter that names only illegal moves still searches
+    /// nothing, even with an attacked queen on the board.
+    #[test]
+    fn searchmoves_strictness_holds_with_attacked_queen() {
+        let mut pos = position("3rr1k1/pp3ppp/1qbQ4/2n1P3/8/3P1N1P/PPPB2P1/1R1K1B1R w - - 1 19");
+        let mut tt = TranspositionTable::new(4);
+        let stop = AtomicBool::new(false);
+        let limits = Arc::new(Mutex::new(SearchLimits {
+            max_depth: 2,
+            ..SearchLimits::default()
+        }));
+        let mut s = Searcher::new(&mut tt, &stop, limits);
+        let illegal = Move::from_uci("e2e5").expect("parse");
+        let r = s.search_root(&mut pos, Some(vec![illegal]), 1, &mut |_| {});
+        assert_eq!(r.best_move, Move::NULL);
+    }
+}
